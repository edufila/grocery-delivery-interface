# Copiá este archivo como .env.local y completá los valores.
# .env.local está ignorado por git: las claves nunca se suben al repo.
#
# Dónde sacarlos: Supabase -> tu proyecto -> Project Settings -> API
#   - Project URL          -> NEXT_PUBLIC_SUPABASE_URL
#   - Project API keys -> anon public -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# La clave "anon" es pública por diseño (viaja al navegador). La que NUNCA
# va acá ni al repo es la "service_role".

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
